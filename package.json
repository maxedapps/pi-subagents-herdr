{
  "name": "@maxedapps/pi-subagents-herdr",
  "version": "0.1.0",
  "description": "Visible, persistent Pi subagents backed by Herdr",
  "type": "module",
  "keywords": ["pi-package", "pi", "herdr", "subagents"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxedapps/pi-subagents-herdr.git"
  },
  "homepage": "https://github.com/maxedapps/pi-subagents-herdr#readme",
  "bugs": {
    "url": "https://github.com/maxedapps/pi-subagents-herdr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "pi": {
    "extensions": ["./extensions/herdr-subagents/index.ts"]
  },
  "files": [
    "extensions/",
    "src/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@types/node": "24.12.0",
    "tsx": "4.23.1",
    "typebox": "1.1.38",
    "typescript": "5.9.3"
  }
}
